# Plantilla de variables de entorno.
# Copia este archivo como .env y reemplaza los marcadores. El .env nunca se sube al repositorio.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=TU_USUARIO
DB_PASS=TU_CONTRASEÑA
DB_NAME=ewb
# Cifrado de la conexión: prefer (local/Docker) | require (Supabase)
DB_SSLMODE=prefer

# --- Entornos en Supabase (archivos aparte, nunca se suben) ---
# .env.entorno_staging y .env.entorno_prod usan las mismas variables con estos valores:
#   DB_HOST=aws-x-sa-east-1.pooler.supabase.com   (Connect > Session pooler)
#   DB_PORT=5432
#   DB_USER=ewb_pipeline.xxxxxxxxxxxxxxxxxxxx      (rol + "." + id del proyecto)
#   DB_PASS=TU_CONTRASEÑA
#   DB_NAME=postgres
#   DB_SSLMODE=require

  create  table "ewb"."public"."sed_entregable_largo__dbt_tmp"
  
  
    as
  
  (
    -- Entregable SED · versión LARGA: una fila por participación (docente y año), igual que consolidado_historico.
-- Conserva todas las filas, también las dos de los docentes de 2026 que están en dos programas.
-- Los datos son los de cada año; nombres y apellidos son los del docente (int_sed_nombres).
with  __dbt__cte__int_sed_nombres as (

-- Entregable SED · nombres y apellidos por separado, una fila por docente (uso interno; no se publica).
-- 1) Los de la base más reciente que los trae separados (2026: NOMBRES / APELLIDOS; 2025: NOMBRES /
--    PRIMER y SEGUNDO APELLIDO). En 2026, si el docente está en dos programas, manda la fila que no es ewb_plus.
-- 2) Si solo participó en 2023 o 2024 (nombre completo en una sola columna), se separa por posición:
--    las dos últimas palabras son los apellidos (con 3 palabras: 1 nombre y 2 apellidos; con 2: 1 y 1).
--    Verificado: en 2023 y 2024 el nombre completo empieza por los nombres. Esos casos quedan marcados.
with c as (
    select * from "ewb"."public"."consolidado_historico"
    where docente_id is not null
),

separados as (
    select
        docente_id,
        (array_agg(nombres order by anio_lectivo desc, case when lower(programa) = 'ewb_plus' then 1 else 0 end)
            filter (where nombres is not null or apellidos is not null))[1]   as nombres,
        (array_agg(apellidos order by anio_lectivo desc, case when lower(programa) = 'ewb_plus' then 1 else 0 end)
            filter (where nombres is not null or apellidos is not null))[1]   as apellidos,
        max(docente_nombre)                                                    as nombre_completo
    from c
    group by docente_id
),

palabras as (
    select *, regexp_split_to_array(trim(nombre_completo), '\s+') as p
    from separados
)

select
    docente_id,
    nombre_completo,
    (nombres is null and apellidos is null)                                   as nombre_aproximado,
    case
        when nombres is not null or apellidos is not null then nombres
        when cardinality(p) >= 4 then array_to_string(p[1:cardinality(p) - 2], ' ')
        else p[1]
    end                                                                       as nombres,
    case
        when nombres is not null or apellidos is not null then apellidos
        when cardinality(p) >= 3 then array_to_string(p[cardinality(p) - 1:cardinality(p)], ' ')
        when cardinality(p) = 2 then p[2]
    end                                                                       as apellidos
from palabras
), c as (
    select * from "ewb"."public"."consolidado_historico"
    where docente_id is not null
)

select
    row_number() over (order by c.anio_lectivo, n.apellidos, n.nombres, c.docente_id, c.programa)::int as no,
    c.anio_lectivo                                                   as anio,
    c.programa,
    c.codigo_dane                                                    as dane,
    c.colegio_nombre                                                 as ied,
    c.tipo_documento,
    c.docente_id                                                     as numero_documento,
    n.nombres,
    n.apellidos,
    c.genero                                                         as sexo,
    c.cargo_estandar                                                 as cargo,
    cast(c.edad as integer)                                          as edad,
    coalesce(nullif(nullif(trim(nivel_estandar), ''), '-'), 'Sin registro')                                            as nivel_cursado,
    case
        when c.retirado_segun_base then 'Retirado'
        when upper(trim(c.recibe_constancia)) in ('SI', 'SÍ') then 'Aprobado'
        when upper(trim(c.recibe_constancia)) = 'NO' then 'Sin constancia'
        else 'Sin registro'
    end as estado_finalizacion,
    coalesce(cast(round(c.score_entrada) as integer)::text, 'Sin registro')                           as es_entrada,
    coalesce(case
        when nullif(trim(c.mcer_entrada), '') is null or trim(c.mcer_entrada) = '-' then null
        when upper(replace(replace(c.mcer_entrada, ' ', ''), '-', '')) = 'PREA1' then 'PRE A1'
        when upper(replace(c.mcer_entrada, ' ', '')) ~ '^[ABC][12]\+?$' then upper(replace(c.mcer_entrada, ' ', ''))
        else trim(c.mcer_entrada)
    end, 'Sin registro')  as nivel_mcer_entrada,
    coalesce(cast(round(c.score_salida) as integer)::text, 'Sin registro')                            as es_salida,
    coalesce(case
        when nullif(trim(c.mcer_salida), '') is null or trim(c.mcer_salida) = '-' then null
        when upper(replace(replace(c.mcer_salida, ' ', ''), '-', '')) = 'PREA1' then 'PRE A1'
        when upper(replace(c.mcer_salida, ' ', '')) ~ '^[ABC][12]\+?$' then upper(replace(c.mcer_salida, ' ', ''))
        else trim(c.mcer_salida)
    end, 'Sin registro')   as nivel_mcer_salida,
    c.aprobado_sed,
    n.nombre_aproximado
from c
left join __dbt__cte__int_sed_nombres n using (docente_id)
  );
  

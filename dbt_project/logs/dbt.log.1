  create view "ewb"."staging"."stg_docentes_2024__dbt_tmp"
    
    
  as (
    with source as (
    select * from "ewb"."raw"."base_docentes_2024"
)

select
    -- DOCENTE
    trim(cast(docente_id as varchar)) as docente_id,
    nullif(trim(replace(replace(replace(replace(replace(replace(replace(' ' || initcap(lower(nullif(regexp_replace(trim(cast(docente_nombre as varchar)), '\s+', ' ', 'g'), ''))) || ' ',
        ' De ', ' de '), ' Del ', ' del '), ' La ', ' la '), ' Las ', ' las '), ' Los ', ' los '), ' Y ', ' y '), ' E ', ' e ')), '') as docente_nombre,
    trim(cast(tipo_documento as varchar)) as tipo_documento,
    trim(cast(genero as varchar)) as genero,
    trim(cast(fecha_nacimiento as varchar)) as fecha_nacimiento,
    lower(nullif(regexp_replace(trim(cast(correo_electronico as varchar)), '\s+', ' ', 'g'), '')) as correo_electronico,
    trim(cast(telefono_celular as varchar)) as telefono_celular,

    -- IED
    nullif(trim(regexp_replace(regexp_replace(regexp_replace(regexp_replace(
        upper(nullif(regexp_replace(trim(cast(colegio_nombre as varchar)), '\s+', ' ', 'g'), '')),
        '^INSTITUCI[OÓ]N EDUCATIVA DISTRITAL\s*|^I\.?\s?E\.?\s?D\.?\s+', 'INSTITUCION EDUCATIVA DISTRITAL '),
        '^ENS\s+', 'ESCUELA NORMAL SUPERIOR '),
        '(#|\mNO\.?|N°)\s*([0-9]+)', 'NO. \2', 'g'),
        '\s+', ' ', 'g')), '') as colegio_nombre,
    trim(cast(codigo_dane as varchar)) as codigo_dane,
    trim(cast(ubicacion_geo as varchar)) as ubicacion_geo,

    -- PERFIL
    trim(cast(nivel_formacion as varchar)) as nivel_formacion,
    trim(cast(cargo_rol as varchar)) as cargo_rol,
    trim(cast(tipo_nombramiento as varchar)) as tipo_nombramiento,
    trim(cast(jornada_laboral as varchar)) as jornada_laboral,
    trim(cast(grado_dicta as varchar)) as grado_dicta,

    -- CURSO
    trim(cast(grupo_id as varchar)) as grupo_id,
    trim(cast(nivel_asignado as varchar)) as nivel_asignado,

    -- METRICAS / HECHOS
    case 
        when cast(english_score_entrada_2024 as varchar) ~ '^[0-9]+(\.[0-9]+)?$' then cast(english_score_entrada_2024 as numeric)
        else null 
    end as score_entrada,
    trim(cast(nivel_mcer_entrada_2024 as varchar)) as mcer_entrada,
    
    case 
        when cast(english_score_salida_2024 as varchar) ~ '^[0-9]+(\.[0-9]+)?$' then cast(english_score_salida_2024 as numeric)
        else null 
    end as score_salida,
    trim(cast(nivel_mcer_salida_2024 as varchar)) as mcer_salida,
    
    case 
        -- Viene como texto con '%' (ej. '100.00%'); se normaliza a decimal 0-1 como 2023 y 2025
        when cast("de_participacion_ewb_2024" as varchar) ~ '^[0-9]+(\.[0-9]+)?%$' then round(cast(replace(cast("de_participacion_ewb_2024" as varchar), '%', '') as numeric) / 100, 4)
        else null 
    end as asistencia_porcentaje,
    case upper(nullif(regexp_replace(trim(cast(recibe_constancia as varchar)), '\s+', ' ', 'g'), ''))
        when 'SI' then 'Si' when 'SÍ' then 'Si' when 'NO' then 'No'
        else nullif(regexp_replace(trim(cast(recibe_constancia as varchar)), '\s+', ' ', 'g'), '') end as recibe_constancia,

    -- ENTREGABLE SED (columnas nuevas de la base validada con la SED; NULL si el Excel no las trae)
    
    cast(nullif(trim(cast("edad" as varchar)), '') as numeric)            as edad,
    -- Nombres y apellidos por separado (NOMBRES y APELLIDOS; o PRIMER y SEGUNDO APELLIDO si la base los trae así)
    nullif(trim(replace(replace(replace(replace(replace(replace(replace(' ' || initcap(lower(nullif(regexp_replace(trim(cast(nullif(trim(cast("nombres" as varchar)), '') as varchar)), '\s+', ' ', 'g'), ''))) || ' ',
        ' De ', ' de '), ' Del ', ' del '), ' La ', ' la '), ' Las ', ' las '), ' Los ', ' los '), ' Y ', ' y '), ' E ', ' e ')), '')           as nombres,
    nullif(trim(replace(replace(replace(replace(replace(replace(replace(' ' || initcap(lower(nullif(regexp_replace(trim(cast(coalesce(nullif(trim(cast("apellidos" as varchar)), ''), nullif(concat_ws(' ', nullif(trim(cast(null as varchar)), ''), nullif(trim(cast(null as varchar)), '')), '')) as varchar)), '\s+', ' ', 'g'), ''))) || ' ',
        ' De ', ' de '), ' Del ', ' del '), ' La ', ' la '), ' Las ', ' las '), ' Los ', ' los '), ' Y ', ' y '), ' E ', ' e ')), '') as apellidos,
    cast(null as varchar)                                          as programa,
    cast(null as varchar)                                          as aprobado_sed,
    -- Retirado según la base: en 2024 la columna "2024 EWB" = 'Deserción'
    coalesce(lower(nullif(trim(cast("2024_ewb" as varchar)), '')) in ('deserción', 'desercion'), false) as retirado_segun_base

from source
  );

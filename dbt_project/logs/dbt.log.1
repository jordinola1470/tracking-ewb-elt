    from "ewb"."staging"."stg_docentes_2023"
),

stg_2024 as (
    select 
        grupo_id,
        nivel_asignado,
        cast(null as varchar) as rt_remoto,
        2024 as source_year
    from "ewb"."staging"."stg_docentes_2024"
),

stg_2025 as (
    select 
        grupo_id,
        nivel_asignado,
        cast(null as varchar) as rt_remoto,

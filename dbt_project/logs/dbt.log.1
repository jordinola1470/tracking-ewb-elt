    grupo_id,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    cast(asistencia_porcentaje as numeric(3,2)),
    recibe_constancia
from "ewb"."staging"."stg_docentes_2024"

union all

select 
    docente_id,
    docente_nombre,
    cast(null as varchar) as tipo_documento,
    genero,
    fecha_nacimiento,
    correo_electronico,
    2025 as anio_lectivo,

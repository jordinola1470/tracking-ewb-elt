  create  table "ewb"."public"."tab_actualizacion__dbt_tmp"
  
  
    as
  
  (
    -- Tablero · una fila con las fechas de actualización (aviso "Actualizado el" del tablero).
-- transformado_en = cuándo se recalcularon las tablas (dbt build); cargado_en = última carga de Excel a raw.
-- Componente: barra_avisos
select
    current_timestamp                                                    as transformado_en,
    (select max(cargado_en) from "ewb"."raw"."_registro_cargas")                         as cargado_en,
    (select max(anio_lectivo) from "ewb"."public"."consolidado_historico")  as ultimo_anio,
    (select count(*) from "ewb"."public"."consolidado_historico")           as registros
  );
  

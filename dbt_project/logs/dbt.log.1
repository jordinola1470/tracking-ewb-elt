  create view "ewb"."staging"."stg_docentes_2024__dbt_tmp"
    
    
  as (
    with source as (
    select * from "ewb"."raw"."base_docentes_2024"
)

select
    -- DOCENTE
    cast(docente_id as varchar) as docente_id,
    cast(docente_nombre as varchar) as docente_nombre,
    cast(tipo_documento as varchar) as tipo_documento,
    cast(genero as varchar) as genero,
    cast(fecha_nacimiento as varchar) as fecha_nacimiento,
    cast(correo_electronico as varchar) as correo_electronico,
    cast(telefono_celular as varchar) as telefono_celular,

    -- IED
    cast(colegio_nombre as varchar) as colegio_nombre,
    cast(codigo_dane as varchar) as codigo_dane,
    cast(ubicacion_geo as varchar) as ubicacion_geo,

    -- PERFIL
    cast(nivel_formacion as varchar) as nivel_formacion,
    cast(cargo_rol as varchar) as cargo_rol,
    cast(tipo_nombramiento as varchar) as tipo_nombramiento,
    cast(jornada_laboral as varchar) as jornada_laboral,
    cast(grado_dicta as varchar) as grado_dicta,

    -- CURSO
    cast(grupo_id as varchar) as grupo_id,
    cast(nivel_asignado as varchar) as nivel_asignado,

    -- METRICAS / HECHOS
    case 
        when cast(english_score_entrada_2024 as varchar) ~ '^[0-9]+(\.[0-9]+)?$' then cast(english_score_entrada_2024 as numeric)
        else null 
    end as score_entrada,
    cast(nivel_mcer_entrada_2024 as varchar) as mcer_entrada,
    
    case 
        when cast(english_score_salida_2024 as varchar) ~ '^[0-9]+(\.[0-9]+)?$' then cast(english_score_salida_2024 as numeric)
        else null 
    end as score_salida,
    cast(nivel_mcer_salida_2024 as varchar) as mcer_salida,
    
    case 
        -- Viene como texto con '%' (ej. '100.00%'); se normaliza a decimal 0-1 como 2023 y 2025
        when cast("de_participacion_ewb_2024" as varchar) ~ '^[0-9]+(\.[0-9]+)?%$' then round(cast(replace(cast("de_participacion_ewb_2024" as varchar), '%', '') as numeric) / 100, 4)
        else null 
    end as asistencia_porcentaje,
    cast(recibe_constancia as varchar) as recibe_constancia

from source
  );

    trim(cast(nivel_asignado as varchar)) as nivel_asignado,

    -- METRICAS / HECHOS
    case 
        when cast(english_score_entrada_2025 as varchar) ~ '^[0-9]+(\.[0-9]+)?$' then cast(english_score_entrada_2025 as numeric)
        else null 
    end as score_entrada,

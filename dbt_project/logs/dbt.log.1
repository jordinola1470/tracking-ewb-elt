  create  table "ewb"."public"."sed_entregable_ancho__dbt_tmp"
  
  
    as
  
  (
    -- Entregable SED · versión ANCHA: una fila por persona formada (2023-2026), en el orden de columnas pedido.
-- Identificación: el último dato disponible (año más reciente con valor). En 2026, si el docente está en dos
-- programas, se conserva la última versión del participante: la fila de ewb_two o ewb_presencial, no la de ewb_plus.
-- Resumen: ES y nivel MCER de entrada = primera prueba de entrada registrada; de salida = última prueba de salida.
-- Por año: nivel cursado, estado al cierre y ES de salida; 'No aplica' si no participó ese año.

with  __dbt__cte__int_sed_nombres as (

-- Entregable SED · nombres y apellidos por separado, una fila por docente (uso interno; no se publica).
-- 1) Los de la base más reciente que los trae separados (2026: NOMBRES / APELLIDOS; 2025: NOMBRES /
--    PRIMER y SEGUNDO APELLIDO). En 2026, si el docente está en dos programas, manda la fila que no es ewb_plus.
-- 2) Si solo participó en 2023 o 2024 (nombre completo en una sola columna), se separa por posición:
--    las dos últimas palabras son los apellidos (con 3 palabras: 1 nombre y 2 apellidos; con 2: 1 y 1).
--    Verificado: en 2023 y 2024 el nombre completo empieza por los nombres. Esos casos quedan marcados.
with c as (
    select * from "ewb"."public"."consolidado_historico"
    where docente_id is not null
),

separados as (
    select
        docente_id,
        (array_agg(nombres order by anio_lectivo desc, case when lower(programa) = 'ewb_plus' then 1 else 0 end)
            filter (where nombres is not null or apellidos is not null))[1]   as nombres,
        (array_agg(apellidos order by anio_lectivo desc, case when lower(programa) = 'ewb_plus' then 1 else 0 end)
            filter (where nombres is not null or apellidos is not null))[1]   as apellidos,
        max(docente_nombre)                                                    as nombre_completo
    from c
    group by docente_id
),

palabras as (
    select *, regexp_split_to_array(trim(nombre_completo), '\s+') as p
    from separados
)

select
    docente_id,
    nombre_completo,
    (nombres is null and apellidos is null)                                   as nombre_aproximado,
    case
        when nombres is not null or apellidos is not null then nombres
        when cardinality(p) >= 4 then array_to_string(p[1:cardinality(p) - 2], ' ')
        else p[1]
    end                                                                       as nombres,
    case
        when nombres is not null or apellidos is not null then apellidos
        when cardinality(p) >= 3 then array_to_string(p[cardinality(p) - 1:cardinality(p)], ' ')
        when cardinality(p) = 2 then p[2]
    end                                                                       as apellidos
from palabras
), c as (
    select
        *,
        case when lower(programa) = 'ewb_plus' then 1 else 0 end                                    as prioridad,
        case nivel_estandar
        when 'PRE_A1' then 1 when 'A1' then 2 when 'A2' then 3 when 'A2+' then 4
        when 'B1' then 5 when 'B1+' then 6 when 'B2' then 7 when 'C1' then 8
        when '-' then 98 else 99 end                           as orden
    from "ewb"."public"."consolidado_historico"
    where docente_id is not null
),

-- Último dato disponible de cada campo de identificación
persona as (
    select
        docente_id,
        (array_agg(codigo_dane    order by anio_lectivo desc, prioridad) filter (where codigo_dane is not null))[1]    as dane,
        (array_agg(colegio_nombre order by anio_lectivo desc, prioridad) filter (where colegio_nombre is not null))[1] as ied,
        (array_agg(tipo_documento order by anio_lectivo desc, prioridad) filter (where tipo_documento is not null))[1] as tipo_documento,
        (array_agg(genero         order by anio_lectivo desc, prioridad) filter (where genero is not null))[1]         as sexo,
        (array_agg(cargo_estandar order by anio_lectivo desc, prioridad) filter (where cargo_estandar is not null))[1] as cargo,
        (array_agg(edad           order by anio_lectivo desc, prioridad) filter (where edad is not null))[1]           as edad,
        count(distinct anio_lectivo)                                                                                  as total_anios_participando
    from c
    group by docente_id
),

-- Primera prueba de entrada y última de salida (puntaje y nivel MCER de la misma prueba)
entrada as (
    select distinct on (docente_id) docente_id, score_entrada, mcer_entrada
    from c
    where (score_entrada is not null or case upper(replace(replace(mcer_entrada, ' ', ''), '-', ''))
        when 'PREA1' then 0 when 'A1' then 1 when 'A2' then 2
        when 'B1' then 3 when 'B2' then 4 when 'C1' then 5 end is not null)
    order by docente_id, anio_lectivo asc, prioridad desc
),

salida as (
    select distinct on (docente_id) docente_id, score_salida, mcer_salida
    from c
    where (score_salida is not null or case upper(replace(replace(mcer_salida, ' ', ''), '-', ''))
        when 'PREA1' then 0 when 'A1' then 1 when 'A2' then 2
        when 'B1' then 3 when 'B2' then 4 when 'C1' then 5 end is not null)
    order by docente_id, anio_lectivo desc, prioridad asc
),

-- Una fila por docente y año: en 2026 manda la que no es ewb_plus; luego la no retirada y la de nivel más alto
por_anio as (
    select distinct on (docente_id, anio_lectivo)
        docente_id,
        anio_lectivo,
        coalesce(nullif(trim(nivel_estandar), ''), '-')                                         as nivel_cursado,
        case
        when retirado_segun_base then 'Retirado'
        when upper(trim(recibe_constancia)) in ('SI', 'SÍ') then 'Aprobado'
        when upper(trim(recibe_constancia)) = 'NO' then 'Sin constancia'
        else '-'
    end                                   as estado_finalizacion,
        coalesce(cast(round(score_salida) as integer)::text, '-')                           as es_salida
    from c
    order by docente_id, anio_lectivo, prioridad, retirado_segun_base, case when orden < 98 then orden end desc nulls last
),

pivote as (
    select
        docente_id,
        coalesce(max(nivel_cursado)       filter (where anio_lectivo = 2023), 'No aplica') as nivel_cursado_2023,
        coalesce(max(estado_finalizacion) filter (where anio_lectivo = 2023), 'No aplica') as estado_finalizacion_2023,
        coalesce(max(es_salida)           filter (where anio_lectivo = 2023), 'No aplica') as es_salida_2023,
        coalesce(max(nivel_cursado)       filter (where anio_lectivo = 2024), 'No aplica') as nivel_cursado_2024,
        coalesce(max(estado_finalizacion) filter (where anio_lectivo = 2024), 'No aplica') as estado_finalizacion_2024,
        coalesce(max(es_salida)           filter (where anio_lectivo = 2024), 'No aplica') as es_salida_2024,
        coalesce(max(nivel_cursado)       filter (where anio_lectivo = 2025), 'No aplica') as nivel_cursado_2025,
        coalesce(max(estado_finalizacion) filter (where anio_lectivo = 2025), 'No aplica') as estado_finalizacion_2025,
        coalesce(max(es_salida)           filter (where anio_lectivo = 2025), 'No aplica') as es_salida_2025,
        coalesce(max(nivel_cursado)       filter (where anio_lectivo = 2026), 'No aplica') as nivel_cursado_2026,
        coalesce(max(estado_finalizacion) filter (where anio_lectivo = 2026), 'No aplica') as estado_finalizacion_2026,
        coalesce(max(es_salida)           filter (where anio_lectivo = 2026), 'No aplica') as es_salida_2026
    from por_anio
    group by docente_id
)

select
    row_number() over (order by n.apellidos, n.nombres, p.docente_id)::int as no,
    p.dane,
    p.ied,
    p.tipo_documento,
    p.docente_id                                                      as numero_documento,
    n.nombres,
    n.apellidos,
    p.sexo,
    p.cargo,
    cast(p.edad as integer)                                           as edad,
    p.total_anios_participando::int                                   as total_anios_participando,
    coalesce(cast(round(e.score_entrada) as integer)::text, '-')                            as es_entrada,
    coalesce(cast(round(s.score_salida) as integer)::text, '-')                             as es_salida,
    coalesce(case
        when nullif(trim(e.mcer_entrada), '') is null or trim(e.mcer_entrada) = '-' then null
        when upper(replace(replace(e.mcer_entrada, ' ', ''), '-', '')) = 'PREA1' then 'PRE A1'
        when upper(replace(e.mcer_entrada, ' ', '')) ~ '^[ABC][12]\+?$' then upper(replace(e.mcer_entrada, ' ', ''))
        else trim(e.mcer_entrada)
    end, '-')   as nivel_mcer_entrada,
    coalesce(case
        when nullif(trim(s.mcer_salida), '') is null or trim(s.mcer_salida) = '-' then null
        when upper(replace(replace(s.mcer_salida, ' ', ''), '-', '')) = 'PREA1' then 'PRE A1'
        when upper(replace(s.mcer_salida, ' ', '')) ~ '^[ABC][12]\+?$' then upper(replace(s.mcer_salida, ' ', ''))
        else trim(s.mcer_salida)
    end, '-')    as nivel_mcer_salida,
    v.nivel_cursado_2023,
    v.estado_finalizacion_2023,
    v.es_salida_2023,
    v.nivel_cursado_2024,
    v.estado_finalizacion_2024,
    v.es_salida_2024,
    v.nivel_cursado_2025,
    v.estado_finalizacion_2025,
    v.es_salida_2025,
    v.nivel_cursado_2026,
    v.estado_finalizacion_2026,
    v.es_salida_2026,
    -- Control (no es parte del formato pedido): nombres y apellidos separados por posición
    n.nombre_aproximado
from persona p
join pivote v using (docente_id)
left join __dbt__cte__int_sed_nombres n using (docente_id)
left join entrada e using (docente_id)
left join salida s using (docente_id)
  );
  

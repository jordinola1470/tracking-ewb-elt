  create  table "ewb"."public"."tab_historial__dbt_tmp"
  
  
    as
  
  (
    -- Tablero · una fila por participación (docente y año), para la ficha del docente.
-- Componente: per_tabla_historial
select
    docente_id,
    anio_lectivo,
    grupo_id                                                       as grupo,
    coalesce(nivel_estandar, 'Sin dato')                           as nivel_formacion,
    case nivel_estandar
        when 'PRE_A1' then 1 when 'A1' then 2 when 'A2' then 3 when 'A2+' then 4
        when 'B1' then 5 when 'B1+' then 6 when 'B2' then 7 when 'C1' then 8
        when '-' then 98 else 99 end                            as orden_nivel,
    case when (score_entrada is not null or mcer_entrada is not null) then 'Sí' else 'No' end        as prueba_entrada,
    case when (score_salida is not null or mcer_salida is not null)  then 'Sí' else 'No' end        as prueba_salida,
    case case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end when 1 then 'Sí' when 0 then 'No' else 'Sin dato' end as constancia,
    asistencia_porcentaje_fix                                      as asistencia,
    coalesce(grupo_id ilike 'retirados%', false)                                            as es_retirado
from "ewb"."public"."consolidado_historico"
where docente_id is not null
  );
  

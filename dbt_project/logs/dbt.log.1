  create  table "ewb"."public"."tab_kpis_anio__dbt_tmp"
  
  
    as
  
  (
    -- Tablero · una fila por año lectivo.
-- Componentes: ana_filtro_anio, ana_texto_resumen, ana_kpi_participaciones, ana_kpi_docentes_unicos,
--              ana_kpi_ied_unicas, ana_kpi_constancia, ana_kpi_asistencia, ana_graf_constancia_anio,
--              ana_graf_pruebas_presentadas
with base as (
    select * from "ewb"."public"."consolidado_historico"
),

-- Asistencia y retirados con una fila por docente y año (igual que el fact sheet):
-- si el Excel trae a un docente dos veces en el año, no se cuenta doble
asistencia as (
    select
        anio_lectivo,
        round((avg(asistencia) filter (where not es_retirado))::numeric, 4)        as asistencia_promedio,
        count(*) filter (where es_retirado)                                        as retirados
    from "ewb"."public"."int_fs_docente_anio"
    group by anio_lectivo
)

select
    anio_lectivo,
    count(*)                                                                    as participaciones,
    count(distinct docente_id)                                                  as docentes_unicos,
    count(distinct codigo_dane)                                                 as ied_unicas,
    count(*) filter (where (score_entrada is not null or mcer_entrada is not null) and (score_salida is not null or mcer_salida is not null))      as con_entrada_salida,
    -- Pruebas presentadas en el año (gráfico ana_graf_pruebas_presentadas)
    count(*) filter (where (score_entrada is not null or mcer_entrada is not null))                               as con_entrada,
    count(*) filter (where (score_salida is not null or mcer_salida is not null))                                as con_salida,
    count(*) filter (where not (score_entrada is not null or mcer_entrada is not null))                           as sin_entrada,
    count(*) filter (where not (score_salida is not null or mcer_salida is not null))                            as sin_salida,
    sum(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end)                                               as con_constancia,
    count(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end)                                             as con_dato_constancia,
    -- Sin constancia = tienen el dato y es "No" (para la barra apilada de constancia por año)
    count(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end) - coalesce(sum(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end), 0) as sin_constancia,
    -- % sobre quienes tienen el dato de constancia (vacío si el año aún no lo trae)
    round(avg(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end)::numeric, 4)                            as pct_constancia,
    -- Asistencia promedio sin contar retirados (escala 0-1) y retirados: una fila por docente y año
    max(a.asistencia_promedio)                                                  as asistencia_promedio,
    max(a.retirados)                                                            as retirados
from base
left join asistencia a using (anio_lectivo)
group by anio_lectivo
  );
  
[0m03:17:18.908764 [debug] [Thread-1 (]: On model.tracking_ewb_ia.tab_fs_resumen: /* {"app": "dbt", "dbt_version": "1.11.4", "profile_name": "tracking_ewb_ia", "target_name": "dev", "node_id": "model.tracking_ewb_ia.tab_fs_resumen"} */

  
    

  create  table "ewb"."public"."tab_fs_resumen__dbt_tmp"
  
  
    as
  
  (
    -- Fact sheet · resumen ejecutivo en una sola fila (secciones 1.1, 4.2 y 8). Componente: rep_fact_sheet
with d as (
    select * from "ewb"."public"."int_fs_docente_anio"
),
total_anios as (select count(distinct anio_lectivo) as n, min(anio_lectivo) as primer, max(anio_lectivo) as ultimo from d),
docente as (
    select docente_id, count(*) as anios, (array_agg(genero order by anio_lectivo desc) filter (where genero is not null))[1] as genero
    from d group by docente_id
),
ied as (
    select codigo_dane, count(distinct anio_lectivo) as anios from d where codigo_dane is not null group by codigo_dane
)
select
    (select count(*) from d)                                                as participaciones,
    (select count(*) from docente)                                          as participantes_unicos,
    (select count(*) from docente where genero = 'Femenino')                as mujeres,
    (select count(*) from docente where genero = 'Masculino')               as hombres,
    (select count(*) from docente where anios = 1)                          as un_anio,
    (select count(*) from docente where anios = 2)                          as dos_anios,
    (select count(*) from docente where anios = 3)                          as tres_anios,
    (select count(*) from docente where anios = 4)                          as cuatro_anios,
    (select count(*) from ied)                                              as colegios,
    (select count(*) from ied, total_anios t where ied.anios = t.n)         as colegios_todos_los_anios,
    t.n                                                                     as anios_programa,
    t.primer                                                                as primer_anio,
    t.ultimo                                                                as ultimo_anio
from total_anios t
  );
  

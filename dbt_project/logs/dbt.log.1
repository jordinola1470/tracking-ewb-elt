    coalesce(cargo_estandar, 'Sin dato')               as cargo,
    count(*)                                           as participaciones,
    count(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end)                    as con_dato_constancia,
    round(avg(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end)::numeric, 4)   as pct_constancia
from "ewb"."public"."consolidado_historico"
group by anio_lectivo, cargo_estandar
  );
  

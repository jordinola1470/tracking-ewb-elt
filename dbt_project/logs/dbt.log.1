    trim(cast(nivel_mcer_entrada_2025 as varchar)) as mcer_entrada,
    
    case 
        when cast(english_score_salida_2025 as varchar) ~ '^[0-9]+(\.[0-9]+)?$' then cast(english_score_salida_2025 as numeric)
        else null 
    end as score_salida,
    trim(cast(nivel_mcer_salida_2025 as varchar)) as mcer_salida,
    
    case 
        when cast(porcentaje_final as varchar) ~ '^[0-9]+(\.[0-9]+)?$' then cast(porcentaje_final as numeric)
        else null 
    end as asistencia_porcentaje,
    case upper(nullif(regexp_replace(trim(cast(recibe_constancia as varchar)), '\s+', ' ', 'g'), ''))
        when 'SI' then 'Si' when 'SÍ' then 'Si' when 'NO' then 'No'
        else nullif(regexp_replace(trim(cast(recibe_constancia as varchar)), '\s+', ' ', 'g'), '') end as recibe_constancia,

    -- ENTREGABLE SED (columnas nuevas de la base validada con la SED; NULL si el Excel no las trae)
    
    cast(nullif(trim(cast("edad" as varchar)), '') as numeric)            as edad,
    nullif(trim(replace(replace(replace(replace(replace(replace(replace(' ' || initcap(lower(nullif(regexp_replace(trim(cast(nullif(trim(cast("nombres" as varchar)), '') as varchar)), '\s+', ' ', 'g'), ''))) || ' ',
        ' De ', ' de '), ' Del ', ' del '), ' La ', ' la '), ' Las ', ' las '), ' Los ', ' los '), ' Y ', ' y '), ' E ', ' e ')), '')           as nombres,
    nullif(trim(replace(replace(replace(replace(replace(replace(replace(' ' || initcap(lower(nullif(regexp_replace(trim(cast(nullif(concat_ws(' ', nullif(trim(cast("primer_apellido" as varchar)), ''), nullif(trim(cast("segundo_apellido" as varchar)), '')), '') as varchar)), '\s+', ' ', 'g'), ''))) || ' ',
        ' De ', ' de '), ' Del ', ' del '), ' La ', ' la '), ' Las ', ' las '), ' Los ', ' los '), ' Y ', ' y '), ' E ', ' e ')), '') as apellidos,
    cast(null as varchar)                                          as programa,
    nullif(trim(cast("aprobado_sed" as varchar)), '')                      as aprobado_sed,
    -- Retirado según la base: grupo "Retirados …"
    coalesce(grupo_id ilike 'retirados%', false)                                            as retirado_segun_base

from source

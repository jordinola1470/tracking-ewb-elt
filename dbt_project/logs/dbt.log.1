    from "ewb"."staging"."stg_docentes_2023"
),

stg_2024 as (
    select 
        docente_id,
        docente_nombre,
        tipo_documento,
        genero,
        fecha_nacimiento,
        correo_electronico,
        telefono_celular,
        2024 as source_year
    from "ewb"."staging"."stg_docentes_2024"
),

stg_2025 as (
    select 
        docente_id,
        docente_nombre,
        null as tipo_documento,
        genero,
        fecha_nacimiento,
        correo_electronico,
        telefono_celular,
        2025 as source_year
    from "ewb"."staging"."stg_docentes_2025"
),

unioned_data as (
    select * from stg_2023
    union all
    select * from stg_2024
    union all
    select * from stg_2025
),

deduplicated as (
    select 
        *,
        row_number() over (partition by docente_id order by source_year desc) as rn
    from unioned_data
    where docente_id is not null
)

select 
    docente_id,
    docente_nombre,
    tipo_documento,
    genero,
    case 
        when fecha_nacimiento is null or fecha_nacimiento = '' then null
        -- basic fallback logic for dates if passed as string
        else fecha_nacimiento 
    end as fecha_nacimiento,
    correo_electronico,
    telefono_celular
from deduplicated
where rn = 1
  );
  

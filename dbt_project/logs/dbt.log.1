  create  table "ewb"."public"."consolidado_historico__dbt_tmp"
  
  
    as
  
  (
    

with unioned as (

select
    docente_id,
    tipo_documento,
    docente_nombre,
    genero,
    fecha_nacimiento,
    correo_electronico,
    cast(2023 as integer) as anio_lectivo,
    nivel_formacion,
    codigo_dane,
    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,
    asistencia_porcentaje as asistencia_porcentaje_fix,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    recibe_constancia
from "ewb"."staging"."stg_docentes_2023"

union all

select
    docente_id,
    tipo_documento,
    docente_nombre,
    genero,
    fecha_nacimiento,
    correo_electronico,
    cast(2024 as integer) as anio_lectivo,
    nivel_formacion,
    codigo_dane,
    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,
    asistencia_porcentaje as asistencia_porcentaje_fix,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    recibe_constancia
from "ewb"."staging"."stg_docentes_2024"

union all

select
    docente_id,
    cast(null as varchar) as tipo_documento,
    docente_nombre,
    genero,
    fecha_nacimiento,
    correo_electronico,
    cast(2025 as integer) as anio_lectivo,
    nivel_formacion,
    codigo_dane,
    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,
    asistencia_porcentaje as asistencia_porcentaje_fix,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    recibe_constancia
from "ewb"."staging"."stg_docentes_2025"

union all

select
    docente_id,
    tipo_documento,
    docente_nombre,
    genero,
    fecha_nacimiento,
    correo_electronico,
    cast(2026 as integer) as anio_lectivo,
    nivel_formacion,
    codigo_dane,
    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,

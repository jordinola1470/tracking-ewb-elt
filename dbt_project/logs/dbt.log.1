  create view "ewb"."staging"."stg_docentes_2026__dbt_tmp"
    
    
  as (
    
with source as (
    select * from "ewb"."raw"."base_docentes_2026"
)

select
    -- DOCENTE
    trim(cast(docente_id as varchar)) as docente_id,
    -- 2026 trae nombres y apellidos por separado
    nullif(trim(replace(replace(replace(replace(replace(replace(replace(' ' || initcap(lower(nullif(regexp_replace(trim(cast(concat_ws(' ', trim(cast(nombres as varchar)), trim(cast(apellidos as varchar))) as varchar)), '\s+', ' ', 'g'), ''))) || ' ',
        ' De ', ' de '), ' Del ', ' del '), ' La ', ' la '), ' Las ', ' las '), ' Los ', ' los '), ' Y ', ' y '), ' E ', ' e ')), '') as docente_nombre,
    -- 2026 viene como 'CC - CEDULA DE CIUDADANIA'; se deja solo el código (CC, CE...) como en 2023/2024
    trim(split_part(cast(tipo_documento as varchar), ' - ', 1)) as tipo_documento,
    -- Sexo: columna GENERO o SEXO del Excel (se agrega después); mientras no exista queda NULL
    trim(nullif(trim(cast(null as varchar)), '')) as genero,
    cast(null as varchar) as fecha_nacimiento,
    lower(nullif(regexp_replace(trim(cast(correo_electronico as varchar)), '\s+', ' ', 'g'), '')) as correo_electronico,
    trim(cast(telefono_celular as varchar)) as telefono_celular,

    -- IED
    nullif(trim(regexp_replace(regexp_replace(regexp_replace(regexp_replace(
        upper(nullif(regexp_replace(trim(cast(colegio_nombre as varchar)), '\s+', ' ', 'g'), '')),
        '^INSTITUCI[OÓ]N EDUCATIVA DISTRITAL\s*|^I\.?\s?E\.?\s?D\.?\s+', 'INSTITUCION EDUCATIVA DISTRITAL '),
        '^ENS\s+', 'ESCUELA NORMAL SUPERIOR '),
        '(#|\mNO\.?|N°)\s*([0-9]+)', 'NO. \2', 'g'),
        '\s+', ' ', 'g')), '') as colegio_nombre,
    trim(cast(codigo_dane as varchar)) as codigo_dane,
    cast(null as varchar) as ubicacion_geo,

    -- PERFIL
    trim(cast(nivel_formacion as varchar)) as nivel_formacion,
    trim(cast(cargo_rol as varchar)) as cargo_rol,
    trim(cast(tipo_nombramiento as varchar)) as tipo_nombramiento,
    cast(null as varchar) as jornada_laboral,
    cast(null as varchar) as grado_dicta,

    -- CURSO
    trim(cast(grupo_id as varchar)) as grupo_id,
    trim(cast(nivel_asignado as varchar)) as nivel_asignado,

    -- METRICAS / HECHOS
    -- Las columnas de entrada 2026 traen contenido mezclado (niveles, puntajes y estados como 'Pendiente'):
    -- el puntaje es el valor numérico de cualquiera de las dos y el MCER es el valor con forma de nivel.
    case
        when trim(cast(nivel_mcer_entrada_2026 as varchar)) ~ '^[0-9]+(\.[0-9]+)?$' then cast(trim(cast(nivel_mcer_entrada_2026 as varchar)) as numeric)
        when trim(cast(english_score_entrada_2026 as varchar)) ~ '^[0-9]+(\.[0-9]+)?$' then cast(trim(cast(english_score_entrada_2026 as varchar)) as numeric)
        else null
    end as score_entrada,
    case
        when upper(trim(cast(nivel_mcer_entrada_2026 as varchar))) ~ '^(PRE[ -]*A1|[ABC][12]\+?)$' then trim(cast(nivel_mcer_entrada_2026 as varchar))
        when upper(trim(cast(english_score_entrada_2026 as varchar))) ~ '^(PRE[ -]*A1|[ABC][12]\+?)$' then trim(cast(english_score_entrada_2026 as varchar))
        else null
    end as mcer_entrada,

    -- Salida 2026: columnas ES SALIDA 2026 - NIVEL SCORE / NIVEL MCER (si existen en el Excel),
    -- separadas por contenido igual que la entrada
    case
        when nullif(trim(cast(null as varchar)), '') ~ '^[0-9]+(\.[0-9]+)?$' then cast(nullif(trim(cast(null as varchar)), '') as numeric)
        when nullif(trim(cast(null as varchar)), '') ~ '^[0-9]+(\.[0-9]+)?$' then cast(nullif(trim(cast(null as varchar)), '') as numeric)
        else null
    end as score_salida,
    case
        when upper(nullif(trim(cast(null as varchar)), '')) ~ '^(PRE[ -]*A1|[ABC][12]\+?)$' then nullif(trim(cast(null as varchar)), '')
        when upper(nullif(trim(cast(null as varchar)), '')) ~ '^(PRE[ -]*A1|[ABC][12]\+?)$' then nullif(trim(cast(null as varchar)), '')
        else null
    end as mcer_salida,

    case
        when cast(porcentaje_final as varchar) ~ '^[0-9]+(\.[0-9]+)?$' then cast(porcentaje_final as numeric)
        else null
    end as asistencia_porcentaje,
    -- Constancia: columna «Recibe Constancia?» (si existe en el Excel)
    case upper(nullif(regexp_replace(trim(cast(nullif(trim(cast(null as varchar)), '') as varchar)), '\s+', ' ', 'g'), ''))
        when 'SI' then 'Si' when 'SÍ' then 'Si' when 'NO' then 'No'
        else nullif(regexp_replace(trim(cast(nullif(trim(cast(null as varchar)), '') as varchar)), '\s+', ' ', 'g'), '') end as recibe_constancia,

    -- ENTREGABLE SED (NULL mientras el Excel no traiga la columna)
    cast(nullif(trim(cast(null as varchar)), '') as numeric)            as edad,
    nullif(trim(replace(replace(replace(replace(replace(replace(replace(' ' || initcap(lower(nullif(regexp_replace(trim(cast(nullif(trim(cast("nombres" as varchar)), '') as varchar)), '\s+', ' ', 'g'), ''))) || ' ',
        ' De ', ' de '), ' Del ', ' del '), ' La ', ' la '), ' Las ', ' las '), ' Los ', ' los '), ' Y ', ' y '), ' E ', ' e ')), '')           as nombres,
    nullif(trim(replace(replace(replace(replace(replace(replace(replace(' ' || initcap(lower(nullif(regexp_replace(trim(cast(nullif(trim(cast("apellidos" as varchar)), '') as varchar)), '\s+', ' ', 'g'), ''))) || ' ',
        ' De ', ' de '), ' Del ', ' del '), ' La ', ' la '), ' Las ', ' las '), ' Los ', ' los '), ' Y ', ' y '), ' E ', ' e ')), '')         as apellidos,
    lower(nullif(trim(cast("programa" as varchar)), ''))                  as programa,
    nullif(trim(cast(null as varchar)), '')                     as aprobado_sed,
    -- Retirado según la base: grupo "Retirados …"
    coalesce(grupo_id ilike 'retirados%', false)                                           as retirado_segun_base

from source
  );
[0m03:17:16.623459 [debug] [Thread-4 (]: On model.tracking_ewb_ia.fct_helpdesk_retiros: /* {"app": "dbt", "dbt_version": "1.11.4", "profile_name": "tracking_ewb_ia", "target_name": "dev", "node_id": "model.tracking_ewb_ia.fct_helpdesk_retiros"} */

  
    

  create  table "ewb"."marts"."fct_helpdesk_retiros__dbt_tmp"
  
  
    as
  
  (
    -- Gold · nivel del curso del que se retiró cada docente, por año (según las alertas del helpdesk).
-- Una fila por docente y año: el último retiro del año (fecha más reciente; si hay empate, la alerta
-- más arriba en el archivo, que viene de la más reciente a la más antigua).
-- Lo usa consolidado_historico para completar el nivel de los retirados que no lo tienen.
with retiros as (
    select
        docente_id, anio_lectivo, fecha_alerta, nivel_curso_antes,
        row_number() over (
            partition by docente_id, anio_lectivo
            order by fecha_alerta desc, fila asc
        ) as orden
    from "ewb"."staging"."stg_helpdesk_alertas"
    where es_retiro and nivel_curso_antes is not null
)

select
    docente_id,
    anio_lectivo,
    nivel_curso_antes as nivel_retiro,
    fecha_alerta      as fecha_retiro
from retiros
where orden = 1
  );
  

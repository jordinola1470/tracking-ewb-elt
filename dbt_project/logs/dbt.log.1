  create  table "ewb"."public"."tab_kpis_anio__dbt_tmp"
  
  
    as
  
  (
    -- Tablero · una fila por año lectivo.
-- Componentes: ana_filtro_anio, ana_texto_resumen, ana_kpi_participaciones, ana_kpi_docentes_unicos,
--              ana_kpi_ied_unicas, ana_kpi_constancia, ana_kpi_asistencia, ana_graf_constancia_anio,
--              ana_graf_pruebas_presentadas
with base as (
    select * from "ewb"."public"."consolidado_historico"
)

select
    anio_lectivo,
    count(*)                                                                    as participaciones,
    count(distinct docente_id)                                                  as docentes_unicos,
    count(distinct codigo_dane)                                                 as ied_unicas,
    count(*) filter (where (score_entrada is not null or mcer_entrada is not null) and (score_salida is not null or mcer_salida is not null))      as con_entrada_salida,
    -- Pruebas presentadas en el año (gráfico ana_graf_pruebas_presentadas)
    count(*) filter (where (score_entrada is not null or mcer_entrada is not null))                               as con_entrada,
    count(*) filter (where (score_salida is not null or mcer_salida is not null))                                as con_salida,
    count(*) filter (where not (score_entrada is not null or mcer_entrada is not null))                           as sin_entrada,
    count(*) filter (where not (score_salida is not null or mcer_salida is not null))                            as sin_salida,
    sum(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end)                                               as con_constancia,
    count(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end)                                             as con_dato_constancia,
    -- Sin constancia = tienen el dato y es "No" (para la barra apilada de constancia por año)
    count(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end) - coalesce(sum(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end), 0) as sin_constancia,
    -- % sobre quienes tienen el dato de constancia (vacío si el año aún no lo trae)
    round(avg(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end)::numeric, 4)                            as pct_constancia,
    -- Asistencia promedio sin contar retirados (escala 0-1)
    round((avg(asistencia_porcentaje_fix) filter (where not coalesce(grupo_id ilike 'retirados%', false)))::numeric, 4) as asistencia_promedio,
    count(*) filter (where coalesce(grupo_id ilike 'retirados%', false))                                 as retirados
from base
group by anio_lectivo
  );
  

with unioned as (

select
    docente_id,
    tipo_documento,
    docente_nombre,
    genero,
    fecha_nacimiento,
    correo_electronico,
    cast(2023 as integer) as anio_lectivo,
    nivel_formacion,
    codigo_dane,
    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,
    asistencia_porcentaje as asistencia_porcentaje_fix,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    recibe_constancia
from "postgres"."staging"."stg_docentes_2023"

union all

select
    docente_id,
    tipo_documento,
    docente_nombre,
    genero,
    fecha_nacimiento,
    correo_electronico,
    cast(2024 as integer) as anio_lectivo,
    nivel_formacion,
    codigo_dane,
    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,
    asistencia_porcentaje as asistencia_porcentaje_fix,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    recibe_constancia
from "postgres"."staging"."stg_docentes_2024"

union all

select
    docente_id,
    cast(null as varchar) as tipo_documento,
    docente_nombre,
    genero,
    fecha_nacimiento,
    correo_electronico,
    cast(2025 as integer) as anio_lectivo,
    nivel_formacion,
    codigo_dane,
    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,
    asistencia_porcentaje as asistencia_porcentaje_fix,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    recibe_constancia
from "postgres"."staging"."stg_docentes_2025"

union all

select
    docente_id,
    tipo_documento,
    docente_nombre,
    genero,
    fecha_nacimiento,
    correo_electronico,
    cast(2026 as integer) as anio_lectivo,
    nivel_formacion,
    codigo_dane,
    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,
    asistencia_porcentaje as asistencia_porcentaje_fix,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    recibe_constancia
from "postgres"."staging"."stg_docentes_2026"

),

-- ── Estandarización entre años ────────────────────────────────────────────────
-- Un solo nombre por docente: el del año más reciente (ya con formato "María del Carmen Pérez")
nombre_docente as (
    select docente_id,
        (array_agg(docente_nombre order by anio_lectivo desc) filter (where docente_nombre is not null))[1] as nombre_unico
    from unioned
    where docente_id is not null
    group by docente_id
),

-- Un solo nombre por IED (código DANE): el del año más reciente; si otra escritura igual trae tildes, esa.
-- El código 108001000000 no identifica una IED (2023 lo usa para varias): se deja el nombre de cada fila.
variantes_ied as (
    select codigo_dane, colegio_nombre, regexp_replace(upper(translate(colegio_nombre, 'ÁÉÍÓÚÜÑáéíóúüñ', 'AEIOUUNaeiouun')), '\s+', ' ', 'g') as clave,
        max(anio_lectivo) as ultimo_anio, count(*) as filas,
        colegio_nombre ~ '[ÁÉÍÓÚÜÑáéíóúüñ]' as con_tilde
    from unioned
    where codigo_dane is not null and codigo_dane::text <> '108001000000' and colegio_nombre is not null
    group by codigo_dane, colegio_nombre
),

clave_reciente as (
    select distinct on (codigo_dane) codigo_dane, clave
    from variantes_ied
    order by codigo_dane, ultimo_anio desc, filas desc, clave
),

nombre_ied_unico as (
    select distinct on (v.codigo_dane) v.codigo_dane, v.colegio_nombre as nombre_unico
    from variantes_ied v
    join clave_reciente c on c.codigo_dane = v.codigo_dane and c.clave = v.clave
    order by v.codigo_dane, v.con_tilde desc, v.ultimo_anio desc, v.filas desc
),

base as (
    select
        u.docente_id, u.tipo_documento,
        coalesce(nd.nombre_unico, u.docente_nombre) as docente_nombre,
        u.genero, u.fecha_nacimiento, u.correo_electronico, u.anio_lectivo, u.nivel_formacion, u.codigo_dane,
        coalesce(ni.nombre_unico, u.colegio_nombre) as colegio_nombre,
        u.cargo_rol, u.grupo_id, u.nivel_asignado, u.asistencia_porcentaje_fix,
        u.score_entrada, u.mcer_entrada, u.score_salida, u.mcer_salida, u.recibe_constancia
    from unioned u
    left join nombre_docente nd on nd.docente_id = u.docente_id
    left join nombre_ied_unico ni on ni.codigo_dane = u.codigo_dane
)

select
    base.*,

    -- Regla Excel sobre nivel_asignado (comparaciones sin distinguir mayúsculas, como en Excel; los NULL se conservan; el trim se aplica en staging)
    case
        when lower(nivel_asignado) in ('entry - pre a1', 'entry - pre-a1') then 'PRE_A1'
        when lower(nivel_asignado) in ('fundamentals - a1', 'fundamentals 2 - a1.2') then 'A1'
        when lower(nivel_asignado) in (
            'evolution/specialist - b1/b2/c1', 'connections a - b1-', 'connections b - b1',
            'connections 4 - b1.4', 'connections 2 - b1.2'
        ) then 'B1'
        when lower(nivel_asignado) in ('progress - a2', 'progress 2 - a2.2') then 'A2'
        when lower(nivel_asignado) in ('evolution/specialist - b2/c1', 'evolution 2 - b2.2') then 'B2'
        when nivel_asignado in ('0', 'NULL') then '-'
        else nivel_asignado
    end as nivel_estandar,

    -- Regla Excel sobre cargo_rol
    case
        when cargo_rol in ('-', 'No') then 'S/N'
        when lower(cargo_rol) in (
            'coordinador(a)', 'coordinador(a) encargado(a)', 'rector(a)', 'rector(a) encargado(a)',
            'directivo docente', 'coordinador', 'rector institucion educativa completa', 'rector'
        ) then 'Directivo Docente'
        when lower(cargo_rol) in (
            'docente', 'docente orientadora', 'docente de aula', 'docente orientador',
            'docente con funciones de apoyo'
        ) then 'Docente de Aula'
        when lower(cargo_rol) = 'psicologa' then 'Otro'
        when lower(cargo_rol) = 'docente de primaria' then 'Docente de Primaria'
        when lower(cargo_rol) = 'docente de contenido' then 'Docente de Contenido'
        else cargo_rol
    end as cargo_estandar

from base

  create  table "ewb"."public"."consolidado_historico__dbt_tmp"
  
  
    as
  
  (
    

with unioned as (

select
    docente_id,
    tipo_documento,
    docente_nombre,
    genero,
    fecha_nacimiento,
    correo_electronico,
    cast(2023 as integer) as anio_lectivo,
    nivel_formacion,
    codigo_dane,
    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,
    asistencia_porcentaje as asistencia_porcentaje_fix,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    recibe_constancia
from "ewb"."staging"."stg_docentes_2023"

union all

select
    docente_id,
    tipo_documento,
    docente_nombre,
    genero,
    fecha_nacimiento,
    correo_electronico,
    cast(2024 as integer) as anio_lectivo,
    nivel_formacion,
    codigo_dane,
    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,
    asistencia_porcentaje as asistencia_porcentaje_fix,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    recibe_constancia
from "ewb"."staging"."stg_docentes_2024"

union all

select
    docente_id,
    cast(null as varchar) as tipo_documento,
    docente_nombre,
    genero,
    fecha_nacimiento,
    correo_electronico,
    cast(2025 as integer) as anio_lectivo,
    nivel_formacion,
    codigo_dane,
    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,
    asistencia_porcentaje as asistencia_porcentaje_fix,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    recibe_constancia
from "ewb"."staging"."stg_docentes_2025"

union all

select
    docente_id,
    tipo_documento,
    docente_nombre,
    genero,
    fecha_nacimiento,
    correo_electronico,
    cast(2026 as integer) as anio_lectivo,
    nivel_formacion,
    codigo_dane,
    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,
    asistencia_porcentaje as asistencia_porcentaje_fix,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    recibe_constancia
from "ewb"."staging"."stg_docentes_2026"

)

select
    unioned.*,

    -- Regla Excel sobre nivel_asignado (comparaciones sin distinguir mayúsculas, como en Excel; los NULL se conservan; el trim se aplica en staging)
    case
        when lower(nivel_asignado) in ('entry - pre a1', 'entry - pre-a1') then 'PRE_A1'
        when lower(nivel_asignado) in ('fundamentals - a1', 'fundamentals 2 - a1.2') then 'A1'
        when lower(nivel_asignado) in (
            'evolution/specialist - b1/b2/c1', 'connections a - b1-', 'connections b - b1',
            'connections 4 - b1.4', 'connections 2 - b1.2'
        ) then 'B1'
        when lower(nivel_asignado) in ('progress - a2', 'progress 2 - a2.2') then 'A2'
        when lower(nivel_asignado) in ('evolution/specialist - b2/c1', 'evolution 2 - b2.2') then 'B2'
        when nivel_asignado in ('0', 'NULL') then '-'
        else nivel_asignado
    end as nivel_estandar,

    -- Regla Excel sobre cargo_rol
    case
        when cargo_rol in ('-', 'No') then 'S/N'
        when lower(cargo_rol) in (
            'coordinador(a)', 'coordinador(a) encargado(a)', 'rector(a)', 'rector(a) encargado(a)',
            'directivo docente', 'coordinador', 'rector institucion educativa completa', 'rector'
        ) then 'Directivo Docente'
        when lower(cargo_rol) in (
            'docente', 'docente orientadora', 'docente de aula', 'docente orientador',
            'docente con funciones de apoyo'
        ) then 'Docente de Aula'
        when lower(cargo_rol) = 'psicologa' then 'Otro'
        when lower(cargo_rol) = 'docente de primaria' then 'Docente de Primaria'
        when lower(cargo_rol) = 'docente de contenido' then 'Docente de Contenido'
        else cargo_rol
    end as cargo_estandar

from unioned
  );
  
[0m08:03:31.940819 [debug] [Thread-1 (]: Opening a new connection, currently in state closed
[0m08:03:31.941295 [debug] [Thread-2 (]: Using postgres connection "model.tracking_ewb_ia.trazabilidad_historica"
[0m08:03:31.941949 [debug] [Thread-2 (]: On model.tracking_ewb_ia.trazabilidad_historica: /* {"app": "dbt", "dbt_version": "1.11.4", "profile_name": "tracking_ewb_ia", "target_name": "dev", "node_id": "model.tracking_ewb_ia.trazabilidad_historica"} */

  
    

  create  table "ewb"."public"."trazabilidad_historica__dbt_tmp"
  
  
    as
  
  (
    

SELECT 
    d.docente_id,
    d.docente_nombre,
    d.tipo_documento,
    -- Pivote de MCER por Año
    MAX(CASE WHEN f.anio_lectivo = 2023 THEN m_out.nivel_mcer END) as mcer_salida_2023,
    MAX(CASE WHEN f.anio_lectivo = 2024 THEN m_out.nivel_mcer END) as mcer_salida_2024,
    MAX(CASE WHEN f.anio_lectivo = 2025 THEN m_out.nivel_mcer END) as mcer_salida_2025,
    -- Máximo nivel alcanzado de forma histórica (ID numérico máximo)
    MAX(f.mcer_salida_id) as id_maximo_historico

FROM "ewb"."marts"."fct_docentes" f
JOIN "ewb"."marts"."dim_docentes" d ON f.docente_id = d.docente_id

-- Cruce para la información de perfil (cargo_rol)
JOIN "ewb"."marts"."dim_perfil" p ON f.perfil_id = p.perfil_id

LEFT JOIN "ewb"."marts"."dim_mcer" m_out ON f.mcer_salida_id = m_out.mcer_id

GROUP BY 
    d.docente_id,
    d.docente_nombre,
    d.tipo_documento
-- Filtro Having: Retenemos únicamente a quienes en SU MEJOR MOMENTO histórico superaron el A2 (mcer_id >= 2)
HAVING MAX(f.mcer_salida_id) >= 2
ORDER BY d.docente_nombre
  );
  

    select 
        codigo_dane,
        colegio_nombre,
        ubicacion_geo,
        2024 as source_year
    from "postgres"."staging"."stg_docentes_2024"
),

stg_2025 as (
    select 
        codigo_dane,
        colegio_nombre,
        ubicacion_geo,
        2025 as source_year
    from "postgres"."staging"."stg_docentes_2025"
),


  create  table "ewb"."marts"."dim_perfil__dbt_tmp"
  
  
    as
  
  (
    with stg_2023 as (
    select 
        docente_id,
        nivel_formacion,
        cargo_rol,
        tipo_nombramiento,
        jornada_laboral,
        cast(null as varchar) as grado_dicta,
        2023 as source_year
    from "ewb"."staging"."stg_docentes_2023"
),

stg_2024 as (
    select 
        docente_id,
        nivel_formacion,
        cargo_rol,
        tipo_nombramiento,
        jornada_laboral,
        grado_dicta,
        2024 as source_year
    from "ewb"."staging"."stg_docentes_2024"
),

stg_2025 as (
    select 
        docente_id,
        nivel_formacion,
        cargo_rol,
        tipo_nombramiento,
        jornada_laboral,
        grado_dicta,
        2025 as source_year
    from "ewb"."staging"."stg_docentes_2025"
),

stg_2026 as (
    select 
        docente_id,
        nivel_formacion,
        cargo_rol,
        tipo_nombramiento,
        jornada_laboral,
        grado_dicta,
        2026 as source_year
    from "ewb"."staging"."stg_docentes_2026"
),


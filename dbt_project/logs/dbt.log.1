    colegio_nombre,
    cargo_rol,
    grupo_id,
    nivel_asignado,
    asistencia_porcentaje as asistencia_porcentaje_fix,
    score_entrada,
    mcer_entrada,
    score_salida,
    mcer_salida,
    recibe_constancia
from "ewb"."staging"."stg_docentes_2025"

)

select
    unioned.*,

    -- Regla Excel sobre nivel_asignado (comparaciones sin distinguir mayúsculas, como en Excel)
    case
        when lower(trim(nivel_asignado)) in ('entry - pre a1', 'entry - pre-a1') then 'PRE_A1'
        when lower(trim(nivel_asignado)) in ('fundamentals - a1', 'fundamentals 2 - a1.2') then 'A1'
        when lower(trim(nivel_asignado)) in (
            'evolution/specialist - b1/b2/c1', 'connections a - b1-', 'connections b - b1',
            'connections 4 - b1.4', 'connections 2 - b1.2'
        ) then 'B1'
        when lower(trim(nivel_asignado)) in ('progress - a2', 'progress 2 - a2.2') then 'A2'
        when lower(trim(nivel_asignado)) in ('evolution/specialist - b2/c1', 'evolution 2 - b2.2') then 'B2'
        when nivel_asignado is null or trim(nivel_asignado) in ('0', 'NULL') then '-'
        else nivel_asignado
    end as nivel_estandar,

    -- Regla Excel sobre cargo_rol
    case
        when cargo_rol is null or trim(cargo_rol) in ('-', 'No') then 'S/N'
        when lower(trim(cargo_rol)) in (
            'coordinador(a)', 'coordinador(a) encargado(a)', 'rector(a)', 'rector(a) encargado(a)',
            'directivo docente', 'coordinador', 'rector institucion educativa completa', 'rector'
        ) then 'Directivo Docente'
        when lower(trim(cargo_rol)) in (
            'docente', 'docente orientadora', 'docente de aula', 'docente orientador',
            'docente con funciones de apoyo'
        ) then 'Docente de Aula'
        when lower(trim(cargo_rol)) = 'psicologa' then 'Otro'
        when lower(trim(cargo_rol)) = 'docente de primaria' then 'Docente de Primaria'
        when lower(trim(cargo_rol)) = 'docente de contenido' then 'Docente de Contenido'
        else cargo_rol
    end as cargo_estandar

from unioned
  );
  
[0m22:56:49.740018 [debug] [Thread-1 (]: Opening a new connection, currently in state closed
[0m22:56:49.740627 [debug] [Thread-2 (]: Using postgres connection "model.tracking_ewb_ia.trazabilidad_historica"
[0m22:56:49.741119 [debug] [Thread-2 (]: On model.tracking_ewb_ia.trazabilidad_historica: /* {"app": "dbt", "dbt_version": "1.11.4", "profile_name": "tracking_ewb_ia", "target_name": "dev", "node_id": "model.tracking_ewb_ia.trazabilidad_historica"} */

  
    

  create  table "ewb"."public"."trazabilidad_historica__dbt_tmp"
  
  
    as
  
  (
    

SELECT 
    d.docente_id,
    d.docente_nombre,
    d.tipo_documento,
    -- Pivote de MCER por Año
    MAX(CASE WHEN f.anio_lectivo = 2023 THEN m_out.nivel_mcer END) as mcer_salida_2023,
    MAX(CASE WHEN f.anio_lectivo = 2024 THEN m_out.nivel_mcer END) as mcer_salida_2024,
    MAX(CASE WHEN f.anio_lectivo = 2025 THEN m_out.nivel_mcer END) as mcer_salida_2025,
    -- Máximo nivel alcanzado de forma histórica (ID numérico máximo)
    MAX(f.mcer_salida_id) as id_maximo_historico

FROM "ewb"."marts"."fct_docentes" f
JOIN "ewb"."marts"."dim_docentes" d ON f.docente_id = d.docente_id

-- Cruce para la información de perfil (cargo_rol)
JOIN "ewb"."marts"."dim_perfil" p ON f.perfil_id = p.perfil_id

LEFT JOIN "ewb"."marts"."dim_mcer" m_out ON f.mcer_salida_id = m_out.mcer_id

GROUP BY 
    d.docente_id,
    d.docente_nombre,
    d.tipo_documento
-- Filtro Having: Retenemos únicamente a quienes en SU MEJOR MOMENTO histórico superaron el A2 (mcer_id >= 2)
HAVING MAX(f.mcer_salida_id) >= 2
ORDER BY d.docente_nombre
  );
  

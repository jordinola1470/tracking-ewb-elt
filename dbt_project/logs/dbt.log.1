  create  table "ewb"."public"."tab_pruebas_nivel_anio__dbt_tmp"
  
  
    as
  
  (
    -- Tablero · una fila por año lectivo y nivel de formación (nivel_estandar = nivel del grupo asignado).
-- Componentes: ana_graf_constancia_nivel, ana_graf_nivel_formacion
with base as (
    select
        *,
        (score_entrada is not null or mcer_entrada is not null) as te,
        (score_salida is not null or mcer_salida is not null)  as ts
    from "ewb"."public"."consolidado_historico"
)

select
    anio_lectivo,
    coalesce(nivel_estandar, 'Sin dato')                          as nivel_formacion,
    case nivel_estandar
        when 'PRE_A1' then 1 when 'A1' then 2 when 'A2' then 3 when 'A2+' then 4
        when 'B1' then 5 when 'B1+' then 6 when 'B2' then 7 when 'C1' then 8
        when '-' then 98 else 99 end                           as orden_nivel,
    count(*)                                                      as matriculados,
    count(*) filter (where te and ts)                             as con_entrada_salida,
    count(*) filter (where te and not ts)                         as solo_entrada,
    count(*) filter (where not te)                                as sin_entrada,
    round((count(*) filter (where te and ts))::numeric / count(*), 4) as pct_entrada_salida,
    round(avg(case when upper(trim(recibe_constancia)) = 'SI' then 1
         when upper(trim(recibe_constancia)) = 'NO' then 0 end)::numeric, 4)              as pct_constancia
from base
group by anio_lectivo, nivel_estandar
  );
  

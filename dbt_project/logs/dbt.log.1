  create  table "ewb"."marts"."dim_ied__dbt_tmp"
  
  
    as
  
  (
    with stg_2023 as (
    select 
        codigo_dane,
        colegio_nombre,
        'No Registrado' as ubicacion_geo,
        2023 as source_year
    from "ewb"."staging"."stg_docentes_2023"
),

stg_2024 as (
    select 
        codigo_dane,
        colegio_nombre,
        ubicacion_geo,
        2024 as source_year
    from "ewb"."staging"."stg_docentes_2024"
),

stg_2025 as (
    select 
        codigo_dane,
        colegio_nombre,
        ubicacion_geo,
        2025 as source_year
    from "ewb"."staging"."stg_docentes_2025"
),

unioned_data as (
    select * from stg_2023
    union all
    select * from stg_2024
    union all
    select * from stg_2025
),

deduplicated as (
    select 
        *,
        row_number() over (partition by codigo_dane order by source_year desc) as rn
    from unioned_data
    where codigo_dane is not null
)

select 
    codigo_dane,
    colegio_nombre,
    ubicacion_geo
from deduplicated
where rn = 1
  );
  

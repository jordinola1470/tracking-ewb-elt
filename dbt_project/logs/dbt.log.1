  create  table "ewb"."public"."tab_perfiles__dbt_tmp"
  
  
    as
  
  (
    -- Tablero · una fila por docente (datos más recientes no vacíos y resumen de su historial).
-- Componentes: per_buscador, per_tabla_docentes, per_ficha_docente
with  __dbt__cte__int_permanencia_docente as (

-- Intermedio (no se publica): permanencia de cada docente según los años en que participó.
-- Lo usan tab_permanencia y tab_perfiles, para que la regla esté en un solo lugar.
with por_docente as (
    select
        docente_id,
        count(distinct anio_lectivo)                       as anios_participados,
        max(anio_lectivo) - min(anio_lectivo) + 1          as rango_anios
    from "ewb"."public"."consolidado_historico"
    where docente_id is not null
    group by docente_id
)

select
    docente_id,
    anios_participados,
    case
        when anios_participados = 1           then '1 año'
        when anios_participados = rango_anios then anios_participados || ' años seguidos'
        else                                       anios_participados || ' años no seguidos'
    end                                                    as permanencia,
    -- Continua = 2 o más años seguidos
    (anios_participados >= 2 and anios_participados = rango_anios) as es_continuo
from por_docente
), base as (
    select * from "ewb"."public"."consolidado_historico"
    where docente_id is not null
),

niveles_anio as (
    -- Nivel de formación de cada año (si hubiera más de un registro en el año, se listan todos)
    select
        docente_id,
        anio_lectivo,
        string_agg(distinct coalesce(nivel_estandar, 'Sin dato'), ' / ') as niveles
    from base
    group by docente_id, anio_lectivo
),

resumen as (
    select
        docente_id,
        string_agg(anio_lectivo::text, ', ' order by anio_lectivo)                     as anios,
        string_agg(anio_lectivo || ': ' || niveles, ' · ' order by anio_lectivo)       as niveles_por_anio
    from niveles_anio
    group by docente_id
),

ultimo as (
    select
        docente_id,
        (array_agg(docente_nombre order by anio_lectivo desc) filter (where docente_nombre is not null))[1] as docente_nombre,
        (array_agg(genero         order by anio_lectivo desc) filter (where genero is not null))[1]         as genero,
        (array_agg(cargo_estandar order by anio_lectivo desc) filter (where cargo_estandar is not null))[1] as cargo,
        (array_agg(colegio_nombre order by anio_lectivo desc) filter (where colegio_nombre is not null))[1] as colegio,
        -- Último nivel de formación: el del año más reciente en que participó SIN retirarse
        -- (si se retiró en 2026 y participó en 2025, queda el nivel de 2025)
        (array_agg(nivel_estandar order by anio_lectivo desc)
            filter (where nivel_estandar is not null and not coalesce(grupo_id ilike 'retirados%', false)))[1]                      as ultimo_nivel_formacion,
        -- Asistencia de esa misma participación (no es un promedio)
        (array_agg(asistencia_porcentaje_fix order by anio_lectivo desc)
            filter (where nivel_estandar is not null and not coalesce(grupo_id ilike 'retirados%', false)))[1]                      as asistencia
    from base
    group by docente_id
)

select
    u.docente_id,
    u.docente_nombre,
    u.genero,
    u.cargo,
    u.colegio,
    u.ultimo_nivel_formacion,
    r.anios,
    r.niveles_por_anio,
    p.permanencia,
    p.es_continuo,
    u.asistencia
from ultimo u
join resumen r using (docente_id)
join __dbt__cte__int_permanencia_docente p using (docente_id)
  );
  

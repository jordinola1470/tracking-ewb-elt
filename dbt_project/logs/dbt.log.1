    case 
        when cast(de_asistencia as varchar) ~ '^[0-9]+(\.[0-9]+)?$' then cast(de_asistencia as numeric)
        else null 
    end as asistencia_porcentaje,
    
    cast(recibe_constancia as varchar) as recibe_constancia

from source
  );

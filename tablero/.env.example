# Variables del tablero (copiar como .env.local para desarrollo; en Vercel van en Settings → Environment Variables).
# Nunca se suben al repositorio.

# --- Login (Auth.js) ---
AUTH_SECRET=TU_LLAVE_SECRETA_DE_32_O_MAS_CARACTERES
AUTH_GOOGLE_ID=TU_CLIENT_ID_DE_GOOGLE
AUTH_GOOGLE_SECRET=TU_CLIENT_SECRET_DE_GOOGLE
AUTH_MICROSOFT_ENTRA_ID_ID=TU_APPLICATION_CLIENT_ID_DE_MICROSOFT
AUTH_MICROSOFT_ENTRA_ID_SECRET=TU_CLIENT_SECRET_DE_MICROSOFT
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# --- Datos: rol de SOLO LECTURA ewb_tablero en Supabase ---
TABLERO_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
TABLERO_DB_PORT=6543
TABLERO_DB_USER=ewb_tablero.xxxxxxxxxxxxxxxxxxxx
TABLERO_DB_PASS=TU_CONTRASEÑA
TABLERO_DB_NAME=postgres
TABLERO_DB_SSLMODE=require

# --- Solo desarrollo local: ver el tablero sin login (se ignora en producción) ---
# TABLERO_SIN_LOGIN=1
